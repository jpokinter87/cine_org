  +        target.write_bytes(b"content")
  +
  +        # Forcer mtime ancienne sur tmp_path (parent de video_dir)
  +        old_ts = time.time() - 365 * 24 * 3600
  +        os.utime(tmp_path, (old_ts, old_ts))
  +        assert tmp_path.stat().st_mtime == pytest.approx(old_ts, abs=1)
  +
  +        from src.adapters.file_system import FileSystemAdapter
  +
  +        fs = FileSystemAdapter()
  +        transferer = TransfererService(fs, fs, storage, video)
  +        transferer._create_mirror_symlink(target)
  +
  +        # tmp_path (parent de video_dir) ne doit pas avoir été bumpé
  +        assert tmp_path.stat().st_mtime == pytest.approx(old_ts, abs=1)
  +
   
