  +    def test_symlink_bumps_ancestor_mtimes_up_to_video_root(self, tmp_path):
  +        """Crée le symlink et propage le mtime des dossiers parents jusqu'à video_dir.
  +
  +        Indispensable pour que les media-centers (Dune 4K, Plex, Kodi…) qui
  +        détectent les nouveautés via la mtime des dossiers de plus haut niveau
  +        voient le contenu fraîchement transféré, alors que POSIX ne touche
  +        que la mtime du parent direct.
  +        """
  +        import time
  +
  +        storage = tmp_path / "storage"
  +        video = tmp_path / "video"
  +
  +        storage_subdir = storage / "Films" / "Drame" / "A-G" / "Cop-Cy"
  +        storage_subdir.mkdir(parents=True)
  +        target = storage_subdir / "Le crime était presque parfait (1954).mkv"
  +        target.write_bytes(b"content")
  +
  +        # Pré-créer la structure video avec une mtime ancienne
  +        ancestors = [
  +            video,
  +            video / "Films",
  +            video / "Films" / "Drame",
  +            video / "Films" / "Drame" / "A-G",
  +        ]
  +        for d in ancestors:
  +            d.mkdir(parents=True, exist_ok=True)
  +        # Forcer mtime ancienne (1 an en arrière) sur tous les ancêtres
  +        old_ts = time.time() - 365 * 24 * 3600
  +        for d in ancestors:
  +            os.utime(d, (old_ts, old_ts))
  +        # Vérifier le préalable
  +        for d in ancestors:
  +            assert d.stat().st_mtime == pytest.approx(old_ts, abs=1)
  +
  +        from src.adapters.file_system import FileSystemAdapter
  +
  +        fs = FileSystemAdapter()
  +        transferer = TransfererService(fs, fs, storage, video)
  +
  +        before = time.time() - 1
  +        transferer._create_mirror_symlink(target)
  +        after = time.time() + 1
  +
  +        # Toute la chaîne d'ancêtres dans video_dir (y compris video_dir lui-même)
  +        # doit avoir une mtime fraîche.
  +        for d in ancestors:
  +            mt = d.stat().st_mtime
  +            assert before <= mt <= after, (
  +                f"{d} non bumpé : {mt} hors de [{before}, {after}]"
  +            )
  +
  +    def test_symlink_bump_does_not_walk_above_video_root(self, tmp_path):
  +        """Le bump de mtime ne touche pas les dossiers au-dessus de video_dir."""
  +        import time
  +
  +        storage = tmp_path / "storage"
