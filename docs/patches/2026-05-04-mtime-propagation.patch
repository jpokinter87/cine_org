  +    def _bump_ancestors_mtime(self, leaf: Path) -> None:
  +        """
  +        Met à jour la mtime de chaque dossier ancêtre jusqu'à `_video_dir` inclus.
  +
  +        Ne touche rien si `leaf` n'est pas sous `_video_dir` (cas d'un symlink
  +        custom hors de la zone scannée par les media-centers). Les erreurs
  +        ponctuelles (permission, montage en lecture seule) sont loguées mais
  +        n'interrompent pas le transfert.
  +        """
  +        try:
  +            video_root = self._video_dir.resolve()
  +        except OSError:
  +            return
  +
  +        try:
  +            current = leaf.parent.resolve()
  +        except OSError:
  +            return
  +
  +        # Vérifier que leaf est bien sous video_dir avant de bumper
  +        try:
  +            current.relative_to(video_root)
  +        except ValueError:
  +            return
  +
  +        now = datetime.now().timestamp()
  +        while True:
  +            try:
  +                os.utime(current, (now, now))
  +            except OSError as e:
  +                logger.warning("Bump mtime impossible sur {} : {}", current, e)
  +            if current == video_root:
  +                break
  +            parent = current.parent
  +            if parent == current:  # garde-fou : remonté à la racine du FS
  +                break
  +            current = parent
  +
